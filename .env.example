# ============================================================
# Environment variables for the Deskhand workshop
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Every checkpoint reads this ONE file at the repo root.
# ============================================================

# Provider selector. One of: "azure", "openai", "anthropic", "gemini",
# "openrouter", "ollama", "lmstudio". LLM_PROVIDERS.md walks through setting
# up each one (free options included).
# Checkpoint 00 (the broken bot) only knows azure and openai: with any other
# provider it falls back to OPENAI_API_KEY / OPENAI_MODEL.
LLM_PROVIDER=azure

# --- Azure OpenAI (used when LLM_PROVIDER=azure) ---
# DEPLOYMENT = the name you gave the deployment in Azure AI Foundry, NOT the
# model name. Structured outputs need api-version 2024-08-01-preview or newer
# on a structured-output-capable model (gpt-4.1, gpt-4o-2024-08-06 or later).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# A SEPARATE deployment of an embedding model — required from checkpoint 03 on
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Optional — a pricier deployment for plan generation (checkpoint 04 routing)
# AZURE_OPENAI_DEPLOYMENT_STRONG=gpt-4.1

# --- OpenAI (used when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODEL_STRONG=gpt-4o

# --- Anthropic / Claude (used when LLM_PROVIDER=anthropic) ---
# Create the key at https://platform.claude.com/settings/keys (Claude Console).
# API usage is billed to the Console organization's credits — a Claude Pro/Max
# subscription does NOT include API access.
ANTHROPIC_API_KEY=
# claude-haiku-5-5 ($0.10/$0.50 per 1M tokens) is the default: checkpoint 04's
# release gate (evals/thresholds.json) is calibrated on it. claude-sonnet-5-5
# ($2/$10) and claude-opus-5-5 ($4/$20; thinking can't be turned off, so runs
# are slower and blow the gate's cost and latency caps) for comparison.
ANTHROPIC_MODEL=claude-haiku-5-5
# Optional — how hard the model thinks: low | medium | high | xhigh | max.
# Unset = the model's default. Leave unset on claude-haiku-4-5 (it rejects it).
# ANTHROPIC_EFFORT=low
# Optional — a different model for plan generation (checkpoint 04 routing)
# ANTHROPIC_MODEL_STRONG=claude-opus-5-5
# Anthropic has no embeddings API, so checkpoints 03+ embed with another
# provider: set EMBEDDING_PROVIDER (any provider in this file but anthropic)
# and fill in that provider's key + embedding model (OPENAI_API_KEY +
# OPENAI_EMBEDDING_MODEL by default).
# EMBEDDING_PROVIDER=openai

# --- Google Gemini (used when LLM_PROVIDER=gemini) ---
# Free tier, no card: create the key at https://aistudio.google.com/apikey.
# The same key as prep-kit/.env works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_MODEL_STRONG=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- OpenRouter (used when LLM_PROVIDER=openrouter) ---
# One key for hundreds of models: https://openrouter.ai/settings/keys.
# openrouter/free picks a free model per request (rate-limited); for steadier
# results name one, e.g. openai/gpt-4o-mini or google/gemini-2.5-flash-lite.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Embeddings are paid (no free embedding model); a few cents covers the course.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_MODEL_STRONG=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Ollama (used when LLM_PROVIDER=ollama) ---
# Runs on your laptop, no key, no bill: https://ollama.com/download, then
#   ollama pull llama3.2
#   ollama pull nomic-embed-text     (checkpoints 03+ only)
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_MODEL_STRONG=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- LM Studio (used when LLM_PROVIDER=lmstudio) ---
# Runs on your laptop, no key, no bill: https://lmstudio.ai. Download a model,
# then Developer tab > Start Server. Copy the model's API identifier from that
# tab (or `lms ls`) into LMSTUDIO_MODEL.
LMSTUDIO_MODEL=google/gemma-3-4b
LMSTUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
# LMSTUDIO_MODEL_STRONG=
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# --- Deskhand Lab model picker (lab/server.py) ---
# The model ids behind "Claude Haiku" and "Claude Sonnet" in the lab's top-bar
# dropdown. "GPT" uses the Azure / OpenAI settings above. Needs ANTHROPIC_API_KEY.
# Claude Haiku 4.5: $1/$5 per 1M tokens. Claude Sonnet 5: $2/$10 per 1M tokens.
LAB_HAIKU_MODEL=claude-haiku-4-5
LAB_SONNET_MODEL=claude-sonnet-5

# --- Workflow runtime (checkpoint 02) ---
# plain = graph.py, the hand-written loop (Session 5).
# langgraph = graph_lg.py, the same nodes on LangGraph (Session 6 lab).
# Checkpoints 03 and 04 always use LangGraph and ignore this.
DESKHAND_RUNTIME=plain

# --- Crash drill (checkpoints 02-04, Session 6 lab / Session 11 chaos row 10) ---
# 1 = the service process dies inside execute_actions, right after a refund
# is sent and before the run's state is saved. Restart WITHOUT it: recovery
# re-runs the node and the idempotency key returns the same refund.
# Never set it anywhere real.
# DESKHAND_CRASH_AFTER_REFUND=1

# --- Tools ---
MOCK_ORDER_API_URL=http://localhost:9000

# --- Budget (checkpoint 04) ---
# DESKHAND_BUDGET_USD_PER_RUN=0.25

# --- Kill switch (checkpoint 04) ---
# 1 = every ticket goes to the human queue: new tickets stop before any LLM
# call, in-flight runs stop at their next step, approved runs never refund.
# Change it, then restart the service.
# DESKHAND_KILL_SWITCH=0

# --- RAGAS (evals/rag_evals.py, checkpoints 03 and 04) ---
# RAGAS sends anonymous usage telemetry unless this is true. rag_evals.py
# also sets it before importing RAGAS.
RAGAS_DO_NOT_TRACK=true

# --- DeepEval (the release gate, checkpoint 04) ---
# DeepEval sends anonymous usage telemetry unless this is set. Its pytest
# plugin loads in every pytest session once deepeval is installed, so
# checkpoint 04's conftest.py and evals modules also set it.
DEEPEVAL_TELEMETRY_OPT_OUT=1

# --- Input guard (checkpoint 04) ---
# heuristic = guardrails.py: a regex pre-gate, then an LLM classifier only on a
#             hit. Free on the happy path; a polite attack with no trigger
#             phrase walks past it.
# nemo      = guardrails_nemo.py: NeMo Guardrails' `self check input` rail on
#             every ticket (rails/config.yml + rails/prompts.yml). One LLM call
#             per ticket, nothing walks past the regex because there is none.
# The order record is screened by the same guard in both modes. This is the
# service default; a single run can override it with POST /tickets
# {"ticket_id": "T-1036", "guard": "nemo"} to compare both on one service.
DESKHAND_GUARD=heuristic

# --- LangSmith (optional tracing) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deskhand
LANGSMITH_TRACING=false
